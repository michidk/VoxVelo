{
	"schemaVersion": 1,
	"id": "voxvelo_fitness_lib",
	"version": "${version}",
	"name": "VoxVelo Fitness Library",
	"description": "Vehicle-independent fitness devices, trainer feedback, HUD and FIT ride recording.",
	"authors": [
		"Michael Lohr"
	],
	"contact": {
		"homepage": "https://github.com/michidk/VoxVelo",
		"sources": "https://github.com/michidk/VoxVelo",
		"issues": "https://github.com/michidk/VoxVelo/issues"
	},
	"license": "MIT",
	"icon": "assets/voxvelo_fitness_lib/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"dev.michidk.voxvelo.fitnesslib.client.FitnessClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	},
	"custom": {
		"voxvelo_fitness_lib:bundled_licenses": {
			"note": "VoxVelo's own code is MIT. This jar bundles third-party libraries under their own licences; full texts are in META-INF/licenses/.",
			"btleplug": {
				"artifact": "natives/*/voxvelo_ble (Rust: btleplug 0.13 and its dependencies)",
				"license": "BSD-3-Clause AND MIT AND Apache-2.0",
				"url": "https://github.com/deviceplug/btleplug",
				"file": "META-INF/licenses/voxvelo_ble-THIRD-PARTY.txt"
			},
			"jmdns": {
				"artifact": "org.jmdns:jmdns:3.6.3",
				"license": "Apache-2.0",
				"url": "https://github.com/jmdns/jmdns",
				"file": "META-INF/licenses/JmDNS-LICENSE.txt"
			}
		}
	}
}
