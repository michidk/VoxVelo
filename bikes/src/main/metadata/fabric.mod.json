{
	"schemaVersion": 1,
	"id": "voxvelo",
	"version": "${version}",
	"name": "VoxVelo Bikes",
	"description": "Rideable multiplayer bicycles for Minecraft with their own physics, collisions, suspension and parts. Ride with the keyboard and mouse.",
	"authors": [
		"Michael Lohr"
	],
	"contact": {
		"homepage": "https://github.com/michidk/VoxVelo",
		"sources": "https://github.com/michidk/VoxVelo",
		"issues": "https://github.com/michidk/VoxVelo/issues"
	},
	"license": "MIT",
	"icon": "assets/voxvelo/icon.png",
	"environment": "*",
	"mixins": [
		{
			"config": "voxvelo.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"main": [
			"dev.michidk.voxvelo.VoxVelo"
		],
		"client": [
			"dev.michidk.voxvelo.client.VoxVeloClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0",
		"geckolib": ">=5.5.7 <6"
	}
}
