{
	"schemaVersion": 1,
	"id": "voxelvelo",
	"version": "${version}",
	"name": "VoxelVelo (Fitness)",
	"description": "Rideable multiplayer bicycles for Minecraft. Ride with the keyboard, or bring a smart trainer and OpenBikeControl steering.",
	"authors": [
		"VoxelVelo contributors"
	],
	"license": "MIT",
	"environment": "*",
	"mixins": [
		{
			"config": "voxelvelo.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"voxelvelo-extension": [
			"dev.michidk.voxelvelo.fitness.FitnessExtension"
		],
		"voxelvelo-client-extension": [
			"dev.michidk.voxelvelo.client.fitness.FitnessClientExtension"
		],
		"main": [
			"dev.michidk.voxelvelo.VoxelVelo"
		],
		"client": [
			"dev.michidk.voxelvelo.client.VoxelVeloClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=5.5.7"
	}
}
